/* Synthetic timing fixture only; these values do not characterize any FPGA. */
library(synthetic) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit(1,pf);
  nom_process : 1;
  nom_voltage : 1;
  nom_temperature : 25;
  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_fall : 80;
  lu_table_template(single) {
    variable_1 : input_net_transition;
    index_1("0.1");
  }
  lu_table_template(check) {
    variable_1 : constrained_pin_transition;
    index_1("0.1");
  }
  cell(CLOCK_BUFFER) {
    area : 1;
    pin(A) { direction : input; capacitance : 0.01; }
    pin(Y) {
      direction : output; function : "A";
      timing() {
        related_pin : "A"; timing_sense : positive_unate;
        cell_rise(single) { values("0.2"); }
        cell_fall(single) { values("0.2"); }
        rise_transition(single) { values("0.1"); }
        fall_transition(single) { values("0.1"); }
      }
    }
  }
  cell(REG) {
    area : 1;
    ff(IQ, IQN) { clocked_on : "CLK"; next_state : "D"; }
    pin(CLK) { direction : input; clock : true; capacitance : 0.01; }
    pin(D) {
      direction : input; capacitance : 0.01;
      timing() {
        related_pin : "CLK"; timing_type : setup_rising;
        rise_constraint(check) { values("1.0"); }
        fall_constraint(check) { values("1.0"); }
      }
      timing() {
        related_pin : "CLK"; timing_type : hold_rising;
        rise_constraint(check) { values("0.25"); }
        fall_constraint(check) { values("0.25"); }
      }
    }
    pin(Q) {
      direction : output; function : "IQ";
      timing() {
        related_pin : "CLK"; timing_type : rising_edge; timing_sense : non_unate;
        cell_rise(single) { values("1.0"); }
        cell_fall(single) { values("1.0"); }
        rise_transition(single) { values("0.1"); }
        fall_transition(single) { values("0.1"); }
      }
    }
  }
}
